<UserControl x:Class="DynamicIsland.Island.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand">
    <Grid Margin="16,0,18,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Placeholder}" VerticalAlignment="Center">
            <Grid>
                <TextBlock x:Name="LogoGlyph" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="Logo" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource IslandFont}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AppText" Grid.Column="1" Margin="8,0,0,0" FontFamily="{StaticResource IslandFont}" FontSize="11"
                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <TextBlock x:Name="BodyText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0" FontFamily="{StaticResource IslandFont}"
                       FontSize="12.5" Foreground="#D0D0D0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
        </Grid>
    </Grid>
</UserControl>
