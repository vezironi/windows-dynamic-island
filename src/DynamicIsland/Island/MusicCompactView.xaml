<UserControl x:Class="DynamicIsland.Island.MusicCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:island="clr-namespace:DynamicIsland.Island">
    <Grid Margin="12,0,14,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Placeholder}">
            <Grid>
                <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="Cover" CornerRadius="6" />
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource IslandFont}" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />

        <island:Equalizer x:Name="Eq" Grid.Column="2" VerticalAlignment="Center" />
    </Grid>
</UserControl>
