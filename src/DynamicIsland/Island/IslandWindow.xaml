<Window x:Class="DynamicIsland.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:island="clr-namespace:DynamicIsland.Island"
        Title="Dynamic Island"
        Width="460" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid x:Name="IslandRoot" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="0" Height="0" Background="Transparent">
            <Path x:Name="NotchPath" Fill="#000000" />
            <Grid x:Name="ContentHost" Margin="10,0,10,0" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <island:MusicCompactView x:Name="CompactView" Visibility="Collapsed" />
                <island:MusicExpandedView x:Name="ExpandedView" Visibility="Collapsed" />
                <island:NotificationView x:Name="NotifView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
