<UserControl x:Class="DynamicIsland.Island.MusicExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource Placeholder}">
            <Grid>
                <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="Cover" CornerRadius="10" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource IslandFont}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ArtistText" Margin="0,2,0,0" FontFamily="{StaticResource IslandFont}" FontSize="12.5"
                       Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Style="{StaticResource IslandIconButton}" Content="&#xE892;" />
            <Button x:Name="PlayButton" Style="{StaticResource IslandIconButton}" Content="&#xE768;" FontSize="22" Width="42" Height="42" />
            <Button x:Name="NextButton" Style="{StaticResource IslandIconButton}" Content="&#xE893;" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" MinWidth="34" FontFamily="{StaticResource IslandFont}" FontSize="11"
                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            <Grid x:Name="Track" Grid.Column="1" Height="4" Margin="8,0" VerticalAlignment="Center">
                <Border Background="#3AFFFFFF" CornerRadius="2" />
                <Border x:Name="Fill" Background="#FFFFFF" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
            </Grid>
            <TextBlock x:Name="DurationText" Grid.Column="2" MinWidth="34" TextAlignment="Right" FontFamily="{StaticResource IslandFont}"
                       FontSize="11" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
